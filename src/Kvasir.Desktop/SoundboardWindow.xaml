<Window x:Class="Kvasir.Desktop.SoundboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Kvasir.Desktop.Localization"
        xmlns:icons="clr-namespace:Kvasir.Desktop.Assets"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Translate Soundboard}" Width="350" Height="420" MinWidth="300" MinHeight="240"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DialogWindow}" WindowStyle="None"
        UseLayoutRounding="True" shell:WindowChrome.WindowChrome="{StaticResource KvasirWindowChrome}">
    <Border Style="{StaticResource Ts.PanelBorder}" Background="{DynamicResource Ts.Canvas}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Style="{StaticResource WindowHeader}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Style="{StaticResource WindowHeaderIcon}" />
                <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Command="{Binding SoundboardCommand}" CommandParameter="sound-stop"
                            ToolTip="{loc:Translate StopEffectsKeepsMusicPlaying}" AutomationProperties.Name="{loc:Translate StopEffects}">
                        <icons:SvgIcon Kind="Stop" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                            ToolTip="{loc:Translate Minimize}" AutomationProperties.Name="{loc:Translate Minimize}">
                        <icons:SvgIcon Kind="Minimize" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click"
                            ToolTip="{loc:Translate Close}" AutomationProperties.Name="{loc:Translate Close}">
                        <icons:SvgIcon Kind="Close" Width="17" Height="17" />
                    </Button>
                </StackPanel>
            </Grid>
            <DockPanel Grid.Row="1" Margin="12,10">
                <CheckBox DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                          Style="{StaticResource Ts.CompactSwitchBox}" Content="{loc:Translate KeepWidgetOnTop}"
                          IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedGuild.Name, FallbackValue={loc:Translate OpenServerHeading}}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <DockPanel Margin="0,3,0,0">
                        <icons:SvgIcon DockPanel.Dock="Left" Kind="Channel" Width="14" Height="14" Margin="0,0,5,0"
                                       Foreground="{DynamicResource Ts.TextSecondary}" />
                        <TextBlock Text="{Binding SelectedChannel.Name, FallbackValue={loc:Translate ChooseChannel}}"
                                   Foreground="{DynamicResource Ts.TextSecondary}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </DockPanel>
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="2" Margin="12,0">
                <ScrollViewer Style="{StaticResource Ts.GutterScrollViewer}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Effects}" AutomationProperties.Name="{loc:Translate SoundboardEffects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,6" Padding="10,5" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SoundboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" IsEnabled="{Binding Ready}" AutomationProperties.Name="{Binding Name}"
                                        ToolTipService.ShowOnDisabled="True">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Ts.CompactButton}">
                                            <Setter Property="ToolTip" Value="{Binding Name}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ready}" Value="False">
                                                    <Setter Property="ToolTip" Value="{Binding Problem}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <DockPanel>
                                        <icons:SvgIcon DockPanel.Dock="Left" Kind="Play" Width="16" Height="16" Margin="0,0,9,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{loc:Translate EmptySoundboardHint}" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource Ts.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Effects.Length}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock Grid.Row="3" Margin="12,7,12,10" Text="{Binding SoundboardStatus}" Foreground="{DynamicResource Ts.TextSecondary}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SoundboardStatus}" AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Border>
</Window>
