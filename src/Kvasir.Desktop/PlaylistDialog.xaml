<controls:ThemedDialogWindow x:Class="Kvasir.Desktop.PlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Kvasir.Desktop.Localization"
        xmlns:controls="clr-namespace:Kvasir.Desktop.Controls"
        Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Style="{StaticResource DialogWindow}">
    <StackPanel Margin="24">
        <TextBlock Text="{loc:Translate PlaylistNameOrLink}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="InputBox" AutomationProperties.Name="{loc:Translate PlaylistNameOrLink}" />
        <StackPanel x:Name="ScopeFields" Margin="0,12,0,0">
            <TextBlock Text="{loc:Translate PlaylistScope}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ScopeBox" SelectedIndex="0" SelectedValuePath="Tag" AutomationProperties.Name="{loc:Translate PlaylistScope}">
                <ComboBoxItem Tag="private" Content="{loc:Translate PrivatePlaylist}" />
                <ComboBoxItem Tag="shared" Content="{loc:Translate SharedPlaylist}" />
                <ComboBoxItem Tag="local" Content="{loc:Translate LocalPlaylistChoice}" />
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="{loc:Translate Cancel}" IsCancel="True" Style="{StaticResource Ts.CompactButton}" Margin="0,0,8,0" />
            <Button x:Name="SubmitButton" IsDefault="True" Click="Submit_Click" Style="{StaticResource Ts.PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</controls:ThemedDialogWindow>
