<Window x:Class="Kvasir.Desktop.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Kvasir.Desktop.Localization"
        xmlns:icons="clr-namespace:Kvasir.Desktop.Assets"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Translate ReleaseNotesTitle}" Width="650" Height="460" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowStyle="None" UseLayoutRounding="True"
        Style="{StaticResource DialogWindow}" KeyDown="Window_KeyDown"
        shell:WindowChrome.WindowChrome="{StaticResource KvasirWindowChrome}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource WindowHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Style="{StaticResource WindowHeaderIcon}" />
            <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Style="{StaticResource CloseCaptionButton}" Click="Close_Click"
                    ToolTip="{loc:Translate Close}" AutomationProperties.Name="{loc:Translate Close}">
                <icons:SvgIcon Kind="Close" Width="17" Height="17" />
            </Button>
        </Grid>
        <ComboBox Grid.Row="1" x:Name="VersionBox" Margin="24,20,24,12" HorizontalAlignment="Left" MinWidth="128"
                  AutomationProperties.Name="{loc:Translate ReleaseNotesVersion}" />
        <ScrollViewer Grid.Row="2" x:Name="NotesScroll" Margin="24,0,16,0"
                      Style="{StaticResource Ts.GutterScrollViewer}" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0" DataContext="{Binding SelectedItem, ElementName=VersionBox}">
                <TextBlock Text="{Binding Heading}" Style="{StaticResource Ts.CardTitleText}" TextWrapping="Wrap" Margin="0,0,0,14" />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <BulletDecorator Margin="0,0,0,10">
                                <BulletDecorator.Bullet>
                                    <TextBlock Text="•" Margin="0,0,8,0" />
                                </BulletDecorator.Bullet>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </BulletDecorator>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="3" Margin="24,12,24,18" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="{loc:Translate Close}" Click="Close_Click" MinWidth="90" />
            <TextBlock x:Name="SaveWarning" Text="{loc:Translate ReleaseNotesSaveFailed}" Style="{StaticResource Ts.Hint}"
                       Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0"
                       AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Window>
