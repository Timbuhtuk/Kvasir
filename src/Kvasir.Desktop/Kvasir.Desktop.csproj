<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>0.0.0</VersionPrefix>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Kvasir\appdata\ds_bot_logo.ico</ApplicationIcon>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)..\..\vendor\nuget;$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StandaloneBotDirectory)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup Condition="'$(StandaloneBotDirectory)' != ''">
    <AssemblyMetadata Include="KvasirStandalone" Value="true" />
    <Content Include="$(StandaloneBotDirectory)\**\*" Exclude="$(StandaloneBotDirectory)\**\*.pdb;$(StandaloneBotDirectory)\appdata\ffplay.exe;$(StandaloneBotDirectory)\appdata\ffprobe.exe"
             Link="bot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kvasir.Desktop.Tests" />
    <PackageReference Include="Tessera.WpfStyles" Version="0.3.0" />
    <ProjectReference Include="..\Kvasir.Control\Kvasir.Control.csproj" />
    <ProjectReference Include="..\Kvasir.Configuration\Kvasir.Configuration.csproj" />
    <ProjectReference Include="..\Kvasir\Kvasir.csproj" ReferenceOutputAssembly="false" />
    <Content Include="..\Kvasir\appdata\configuration.json.example" Link="Defaults\configuration.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="..\Kvasir\appdata\ds_bot_logo.ico" Link="ds_bot_logo.ico" />
    <Resource Include="Assets\Icons\*.svg" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="Kvasir.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\docs\release-notes.json" LogicalName="Kvasir.ReleaseNotes.json" />
    <EmbeddedResource Include="Services\Maintenance.ps1" LogicalName="Kvasir.Maintenance.ps1" />
    <Content Include="..\..\docs\DESKTOP.md" Link="DESKTOP.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\DESKTOP-VALIDATION.md" Link="DESKTOP-VALIDATION.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\vendor\Tessera.WpfStyles\licenses\*.txt" Link="licenses\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyBotForDesktop" AfterTargets="Build" Condition="'$(StandaloneBotDirectory)' == ''">
    <MSBuild Projects="..\Kvasir\Kvasir.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=net10.0">
      <Output TaskParameter="TargetOutputs" ItemName="BotAssembly" />
    </MSBuild>
    <ItemGroup>
      <BotOutput Include="%(BotAssembly.RootDir)%(BotAssembly.Directory)**\*" Exclude="%(BotAssembly.RootDir)%(BotAssembly.Directory)publish\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BotOutput)" DestinationFiles="@(BotOutput->'$(TargetDir)bot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
