<Window x:Class="Kvasir.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Kvasir.Desktop.Localization"
        xmlns:icons="clr-namespace:Kvasir.Desktop.Assets"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:tessera="clr-namespace:Tessera.WpfStyles.Controls;assembly=Tessera.WpfStyles"
        Title="{loc:Translate SettingsWindowTitle}" Width="700" Height="840" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Style="{StaticResource DialogWindow}" KeyDown="Window_KeyDown" WindowStyle="None" UseLayoutRounding="True"
        shell:WindowChrome.WindowChrome="{StaticResource KvasirWindowChrome}">
    <Window.Resources>
        <Style x:Key="NotificationPositionChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ts.TextSecondary}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="frame" Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="Background" Value="{DynamicResource Ts.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Ts.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ts.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Ts.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ts.Text}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Frame" Background="{DynamicResource Ts.Panel}" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Ellipse Stroke="{DynamicResource Ts.BorderStrong}" StrokeThickness="1" />
                            <Ellipse x:Name="Selection" Width="8" Height="8" Fill="{DynamicResource Ts.Accent}" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Ts.Hover}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ts.Accent}" /><Setter TargetName="Selection" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ts.Focus}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource WindowHeader}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Style="{StaticResource WindowHeaderIcon}" />
            <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Content="{loc:Translate OpenLog}" Click="Journal_Click"
                    Style="{StaticResource Ts.CompactButton}" VerticalAlignment="Center" Margin="8,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                        ToolTip="{loc:Translate Minimize}" AutomationProperties.Name="{loc:Translate Minimize}">
                    <icons:SvgIcon Kind="Minimize" Width="15" Height="15" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                        ToolTip="{loc:Translate MaximizeRestore}" AutomationProperties.Name="{loc:Translate MaximizeOrRestore}">
                    <icons:SvgIcon Kind="Maximize" Width="15" Height="15" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click"
                        ToolTip="{loc:Translate Close}" AutomationProperties.Name="{loc:Translate Close}">
                    <icons:SvgIcon Kind="Close" Width="17" Height="17" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource Ts.GutterScrollViewer}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,8">
                <TextBlock Text="{loc:Translate InterfaceLanguage}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageSelected" SelectedValuePath="Tag"
                          AutomationProperties.Name="{loc:Translate InterfaceLanguage}" Margin="0,0,0,8">
                    <ComboBoxItem Tag="ru" Content="{loc:Translate RussianLanguage}" />
                    <ComboBoxItem Tag="en" Content="{loc:Translate EnglishLanguage}" />
                </ComboBox>
                <TextBlock Text="{loc:Translate LanguageAppliesAfterRestart}" Style="{StaticResource Ts.Hint}" />
                <TextBlock x:Name="LanguageSavedHint" Text="{loc:Translate LanguageSaved}" Visibility="Collapsed"
                           Style="{StaticResource Ts.Hint}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                <Separator Margin="0,12,0,16" />

                <TextBlock Text="{loc:Translate NotificationPosition}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Border Width="164" HorizontalAlignment="Left" Padding="4" CornerRadius="5"
                        Background="{DynamicResource Ts.Canvas}" BorderBrush="{DynamicResource Ts.BorderStrong}" BorderThickness="1">
                    <UniformGrid x:Name="NotificationPositions" Columns="3" Rows="3" Height="96"
                                 KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="{loc:Translate NotificationPosition}" />
                </Border>
                <TextBlock x:Name="NotificationPositionValue" Foreground="{DynamicResource Ts.TextSecondary}" Margin="0,6,0,8" />
                <Button Content="{loc:Translate PreviewNotification}" HorizontalAlignment="Left" Click="PreviewNotification_Click" />
                <Separator Margin="0,16" />

                <TextBlock Text="{loc:Translate ApplicationTheme}" FontWeight="SemiBold" Margin="0,0,0,14" />
                <RadioButton x:Name="lightTheme" Tag="Light" GroupName="AppearanceTheme" Style="{StaticResource ThemeChoice}" Checked="ThemeSelected" AutomationProperties.Name="{loc:Translate LightTheme}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="44" Background="#E5E2D5" BorderBrush="#AAA99B" BorderThickness="1" HorizontalAlignment="Left">
                            <StackPanel Margin="6"><Border Height="6" Background="#383B35" Margin="0,0,0,5" /><Border Height="18" Background="#D8D5C8" BorderBrush="#AAA99B" BorderThickness="1" /></StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{loc:Translate LightTheme}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Translate SoftLightSurfaces}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="darkTheme" Tag="Dark" GroupName="AppearanceTheme" Style="{StaticResource ThemeChoice}" Checked="ThemeSelected" AutomationProperties.Name="{loc:Translate DarkTheme}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="44" Background="#101010" BorderBrush="#686868" BorderThickness="1" HorizontalAlignment="Left">
                            <StackPanel Margin="6"><Border Height="6" Background="#EEEEEE" Margin="0,0,0,5" /><Border Height="18" Background="#191919" BorderBrush="#3A3A3A" BorderThickness="1" /></StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{loc:Translate DarkTheme}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Translate CalmMonochrome}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="contrastTheme" Tag="Contrast" GroupName="AppearanceTheme" Style="{StaticResource ThemeChoice}" Checked="ThemeSelected" AutomationProperties.Name="{loc:Translate ContrastTheme}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="44" Background="#0C0C0C" BorderBrush="#808080" BorderThickness="1" HorizontalAlignment="Left">
                            <StackPanel Margin="6"><Border Height="6" Background="#FF7424" Margin="0,0,0,5" /><Border Height="18" Background="#202020" BorderBrush="#4B4B4B" BorderThickness="1" /></StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{loc:Translate ContrastTheme}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Translate DarkWithAnOrangeAccent}" Foreground="{DynamicResource Ts.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </RadioButton>
                <TextBlock Text="{loc:Translate ThemeAppliedImmediatelySavedAutomatically}" Foreground="{DynamicResource Ts.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,6" />
                <Separator Margin="0,12,0,16" />
                <TextBlock Text="{loc:Translate BotConfiguration}" Style="{StaticResource Ts.CardTitleText}" Margin="0,0,0,8" />
                <TextBlock Text="{loc:Translate AudioConversionPreference}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ComboBox x:Name="AudioConversionBox" SelectionChanged="AudioConversionSelected" SelectedValuePath="Tag"
                          AutomationProperties.Name="{loc:Translate AudioConversionPreference}" Margin="0,0,0,8">
                    <ComboBoxItem Tag="disk" Content="{loc:Translate AudioConversionDisk}" />
                    <ComboBoxItem Tag="cpu" Content="{loc:Translate AudioConversionCpu}" />
                </ComboBox>
                <TextBlock Text="{loc:Translate AudioConversionHint}" Style="{StaticResource Ts.Hint}" Margin="0,0,0,12" />
                <TextBlock Text="{loc:Translate BotConfigurationHint}" Style="{StaticResource Ts.Hint}" />
                <TextBox x:Name="ConfigurationPathBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,12"
                         AutomationProperties.Name="{loc:Translate BotConfigurationFile}" />
                <WrapPanel>
                    <Button Content="{loc:Translate ReplaceToken}" Click="Token_Click" Style="{StaticResource ActionButton}" />
                    <Button Content="{loc:Translate OpenConfiguration}" Click="OpenConfiguration_Click" Style="{StaticResource ActionButton}" />
                    <Button Content="{loc:Translate OpenDataFolder}" Click="OpenDataFolder_Click" Style="{StaticResource ActionButton}" />
                    <Button Content="{loc:Translate ReleaseNotesTitle}" Click="ReleaseNotes_Click" Style="{StaticResource ActionButton}" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="SettingsMessage" TextWrapping="Wrap" Foreground="{DynamicResource Ts.TextSecondary}"
                   Margin="24,8,24,20" AutomationProperties.LiveSetting="Polite" />
        <tessera:NotificationDisplay x:Name="NotificationPreview" Grid.Row="1" DismissText="{loc:Translate DismissNotification}" />
    </Grid>
</Window>
