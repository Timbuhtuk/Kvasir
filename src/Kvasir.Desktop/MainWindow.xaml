<Window x:Class="Kvasir.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Kvasir.Desktop.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:icons="clr-namespace:Kvasir.Desktop.Assets"
        xmlns:controls="clr-namespace:Kvasir.Desktop.Controls"
        xmlns:vm="clr-namespace:Kvasir.Desktop.ViewModels"
        xmlns:protocol="clr-namespace:Kvasir.Control;assembly=Kvasir.Control"
        xmlns:tessera="clr-namespace:Tessera.WpfStyles.Controls;assembly=Tessera.WpfStyles"
        xmlns:motion="clr-namespace:Tessera.WpfStyles.Motion;assembly=Tessera.WpfStyles"
        Title="Kvasir" Width="1220" Height="820" MinWidth="980" MinHeight="680"
        Icon="ds_bot_logo.ico" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}" WindowStyle="None"
        shell:WindowChrome.WindowChrome="{StaticResource KvasirWindowChrome}">
    <Window.Resources>
        <icons:DurationConverter x:Key="Duration" />
        <BooleanToVisibilityConverter x:Key="Visible" />
        <SolidColorBrush x:Key="BotDisconnectedBrush" Color="#E34F56" />
        <SolidColorBrush x:Key="BotConnectingBrush" Color="#DE861D" />
        <SolidColorBrush x:Key="BotConnectedBrush" Color="#339E68" />
        <Style x:Key="WorkLoader" TargetType="tessera:CarouselLoader">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="LayoutTransform">
                <Setter.Value><ScaleTransform ScaleX="0.25" ScaleY="0.25" /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="False">
                    <Setter Property="IsPaused" Value="True" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TrackDownloadIndicator" TargetType="ContentControl">
            <Setter Property="Width" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DownloadState}" Value="{x:Static protocol:TrackDownloadState.Pending}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="ToolTip" Value="{loc:Translate TrackNotDownloaded}" />
                    <Setter Property="AutomationProperties.Name" Value="{loc:Translate TrackNotDownloaded}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContentControl">
                                <Grid Background="Transparent">
                                    <icons:SvgIcon Kind="Warning" Width="16" Height="16" Foreground="{DynamicResource Ts.Text}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding DownloadState}" Value="{x:Static protocol:TrackDownloadState.Downloading}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="ToolTip" Value="{loc:Translate TrackDownloading}" />
                    <Setter Property="AutomationProperties.Name" Value="{loc:Translate TrackDownloading}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContentControl">
                                <Grid Background="Transparent">
                                    <ProgressBar Width="20" Height="4" IsIndeterminate="True"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{loc:Translate TrackDownloading}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource Ts.ProgressBar}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsVisible" Value="False">
                                                        <Setter Property="motion:BusyProgressMotion.IsEnabled" Value="False" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Ts.CompactButton}">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{DynamicResource Ts.Raised}" />
        </Style>
        <Style x:Key="PlaybackPanelButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="ToolTip" Value="{loc:Translate OpenPlaybackPanel}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="ToolTip" Value="{loc:Translate ClosePlaybackPanel}" />
                    <Setter Property="Foreground" Value="{DynamicResource Ts.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlaybackPanelTrackItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="AutomationProperties.Name" Value="{Binding}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TrackFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackFrame" Property="Background" Value="{DynamicResource Ts.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TrackFrame" Property="Background" Value="{DynamicResource Ts.Raised}" />
                                <Setter TargetName="TrackFrame" Property="BorderBrush" Value="{DynamicResource Ts.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TrackFrame" Property="BorderBrush" Value="{DynamicResource Ts.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlaybackPanelList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Style.Resources>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </Style.Resources>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PlaybackPanelTrackItem}" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
        <DataTemplate x:Key="PlaybackPanelTrack">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource Ts.Raised}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="4" RadiusY="4" /></Grid.Clip>
                        <icons:SvgIcon Kind="Music" Width="18" Height="18" Foreground="{DynamicResource Ts.TextMuted}" />
                        <controls:TrackCover Link="{Binding Link}" Stretch="UniformToFill"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding Author}" Foreground="{DynamicResource Ts.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Author}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Duration, Converter={StaticResource Duration}}" FontSize="12"
                           Foreground="{DynamicResource Ts.TextSecondary}" VerticalAlignment="Center" Margin="8,0,4,0" />
            </Grid>
        </DataTemplate>
        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="7,12" /><Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource Ts.TextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Ts.Hover}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Ts.Raised}" /><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Ts.Text}" /><Setter Property="Foreground" Value="{DynamicResource Ts.Text}" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Ts.TextSecondary}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=NavigationToggle}" Value="True">
                    <Setter Property="Padding" Value="0,12,2,12" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="ToolTip" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=NavigationToggle}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlaylistItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <Border x:Name="SelectionMark" Width="2" HorizontalAlignment="Left" Background="{DynamicResource Ts.Accent}"
                                        Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Ts.Focus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerTab" TargetType="TabItem" BasedOn="{StaticResource Ts.UnderlineTabItem}">
            <Setter Property="Padding" Value="12,0,4,0" />
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="MaxWidth" Value="280" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Ts.Canvas}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="{DynamicResource Ts.Canvas}" />
            <Setter Property="Foreground" Value="{DynamicResource Ts.TextSecondary}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <DockPanel>
                            <Path x:Name="SortArrow" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                                  Fill="{DynamicResource Ts.Accent}" Visibility="Collapsed" Data="M 0,5 L 4,1 L 8,5 Z" />
                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0,1 L 4,5 L 8,1 Z" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactTableHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableHeader}">
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style x:Key="DurationHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CompactTableHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="TableCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Ts.Focus}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TableText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource Ts.TextSecondary}" />
        </Style>
        <Style x:Key="TableTitle" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ts.Text}" />
        </Style>
        <Style x:Key="TableDuration" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="TableDetail" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="TrackGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Style.Resources>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableHeader}" />
                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableCell}" />
            </Style.Resources>
            <Setter Property="IsReadOnly" Value="True" /><Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" /><Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="30" /><Setter Property="ColumnHeaderHeight" Value="32" />
            <Setter Property="GridLinesVisibility" Value="None" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Ts.Canvas}" />
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource Ts.PanelBorder}" Background="{DynamicResource Ts.Canvas}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="112" /></Grid.RowDefinitions>
            <Grid Style="{StaticResource WindowHeader}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Style="{StaticResource WindowHeaderIcon}" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BotStartButton" Style="{StaticResource HeaderIconButton}" Click="Start_Click" IsEnabled="{Binding CanStart}"
                            ToolTip="{loc:Translate StartBot}" AutomationProperties.Name="{loc:Translate StartBot}">
                        <icons:SvgIcon Kind="Play" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="BotStopButton" Grid.Column="1" Style="{StaticResource HeaderIconButton}" Click="Stop_Click" IsEnabled="{Binding CanStop}"
                            ToolTip="{loc:Translate StopBot}" AutomationProperties.Name="{loc:Translate StopBot}">
                        <icons:SvgIcon Kind="Stop" Width="16" Height="16" Foreground="{StaticResource BotDisconnectedBrush}" />
                    </Button>
                    <Ellipse x:Name="BotStatusDot" Grid.Column="2" Width="6" Height="6" Margin="12,0,8,0" VerticalAlignment="Center"
                             ToolTip="{Binding Status}" AutomationProperties.Name="{Binding Status}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BotDisconnectedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static vm:BotConnectionState.Connecting}">
                                        <Setter Property="Fill" Value="{StaticResource BotConnectingBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static vm:BotConnectionState.Connected}">
                                        <Setter Property="Fill" Value="{StaticResource BotConnectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                <tessera:CarouselLoader x:Name="OperationLoader" Grid.Column="2" Style="{StaticResource WorkLoader}"
                                       Margin="16,0,0,0" Visibility="{Binding IsWaiting, Converter={StaticResource Visible}}"
                                       AutomationProperties.Name="{loc:Translate Working}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <icons:SvgIcon Kind="Channel" Width="16" Height="16" Margin="0,0,6,0"
                                   Visibility="{Binding HasServer, Converter={StaticResource Visible}}" />
                    <ComboBox x:Name="VoiceChannelBox" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}"
                              Width="190" Height="32" MinHeight="28" Padding="6,3" IsEnabled="{Binding GuildEnabled}"
                              Visibility="{Binding HasServer, Converter={StaticResource Visible}}"
                              ToolTip="{loc:Translate VoiceChannel}" AutomationProperties.Name="{loc:Translate VoiceChannel}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Click="Settings_Click" ToolTip="{loc:Translate Settings}" AutomationProperties.Name="{loc:Translate Settings}"><icons:SvgIcon Kind="Settings" Width="18" Height="18" /></Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="{loc:Translate Minimize}" AutomationProperties.Name="{loc:Translate Minimize}"><icons:SvgIcon Kind="Minimize" Width="15" Height="15" /></Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="{loc:Translate MaximizeRestore}" AutomationProperties.Name="{loc:Translate MaximizeOrRestore}"><icons:SvgIcon Kind="Maximize" Width="15" Height="15" /></Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="{loc:Translate Close}" AutomationProperties.Name="{loc:Translate Close}"><icons:SvgIcon Kind="Close" Width="17" Height="17" /></Button>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Ts.PanelBorder}" BorderThickness="0,0,0,1" MinHeight="30">
                <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="AddServer_Click" IsEnabled="{Binding CanSelect}"
                            Style="{StaticResource IconButton}" Width="28" Height="28" Padding="5" VerticalAlignment="Top"
                            Margin="6,0,10,0" ToolTip="{loc:Translate OpenServer}" AutomationProperties.Name="{loc:Translate OpenServer}">
                        <icons:SvgIcon Kind="Plus" Width="16" Height="16" />
                    </Button>
                    <TabControl x:Name="ServerTabs" ItemsSource="{Binding OpenServers}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                Style="{StaticResource Ts.UnderlineTabs}" ItemContainerStyle="{StaticResource ServerTab}"
                                AutomationProperties.Name="{loc:Translate OpenServers}">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <ScrollViewer Style="{StaticResource Ts.GutterScrollViewer}" Background="Transparent"
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.TabNavigation="Once" />
                                </ScrollViewer>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </TabControl.ItemsPanel>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="24" Padding="5"
                                            Click="CloseServer_Click" ToolTip="{loc:Translate CloseTabKeepsMusicPlaying}"
                                            AutomationProperties.Name="{loc:Translate CloseServerTab}">
                                        <icons:SvgIcon Kind="Close" Width="14" Height="14" />
                                    </Button>
                                    <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding Name}" />
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                    </TabControl>
                </DockPanel>
                <Grid Margin="12,2,12,5" Visibility="{Binding HasMediaStatus, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding MediaText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MediaDetails}"
                               AutomationProperties.HelpText="{Binding MediaDetails}" VerticalAlignment="Center" />
                    <ProgressBar x:Name="MediaProgressBar" Grid.Column="1" Width="100" Height="5" Margin="10,0,0,0" VerticalAlignment="Center"
                                 Minimum="0" Maximum="100" Value="{Binding MediaPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding MediaIndeterminate}" Visibility="{Binding MediaWorking, Converter={StaticResource Visible}}"
                                 AutomationProperties.Name="{Binding MediaText}" />
                </Grid>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasServer}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="NavigationPane" BorderBrush="{DynamicResource Ts.Border}" BorderThickness="0,0,1,0" Padding="4,8,4,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="132" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=NavigationToggle}" Value="True">
                                    <Setter Property="Width" Value="52" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <ToggleButton x:Name="NavigationToggle" DockPanel.Dock="Top" Width="36" Height="34" MinHeight="34"
                                      Padding="8,6" Margin="0,0,0,6" Background="Transparent" BorderBrush="Transparent">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Setter Property="ToolTip" Value="{loc:Translate CollapseSections}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="{loc:Translate ExpandSections}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
